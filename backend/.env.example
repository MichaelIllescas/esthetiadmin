# Copy this file to .env and fill in the real values. Never commit .env.
SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=3306
DB_NAME=esthetiadmin
DB_USER=root
DB_PASSWORD=change-me

# Secret used to sign tokens: at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-with-at-least-32-characters
JWT_EXPIRATION_MINUTES=480

# Frontend origin(s) allowed by CORS, comma separated
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Initial user, created on startup only if no user exists yet (min. 8 characters)
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars

# Appointment emails (ADR 016), any SMTP server. Leave MAIL_ENABLED=false to send nothing.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
# 587 with STARTTLS (MAIL_STARTTLS=true) or 465 with SSL (MAIL_SSL=true, MAIL_STARTTLS=false)
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL=false
MAIL_USERNAME=turnos@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=turnos@example.com
# Panel address, used in the owner's email to open the agenda
PANEL_URL=http://localhost:4200
